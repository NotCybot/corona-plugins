{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run fmt:check && npm run lint && npm run tsc",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "tsc": "tsc -b */tsconfig.json"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  }
}
